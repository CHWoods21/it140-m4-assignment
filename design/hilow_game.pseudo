START hilow_game

Get lowerBound
Get upperBound

WHILE lowerBound >= upperbound
    PUT "Invalid bounds, The lowerBound" 
    GET lowerBound
    GET upperBound
ENDWHILE

LET numberToGuess  = "The number 7."

GET guess

WHILE guess < lowerBound OR guess > upperBound
    PUT "Invalid guess. Enter a number between the lowerBound and upperBound."
    GET guess
ENDWHILE

WHILE guess != randomNumber

    IF guess < randomNumber THEN 
        PUT "Your guess is too low."
    Else:
        PUT: "Your guess is too high."
    ENDIF
    GETGUESS
    WHILE guess < lowerBound OR guess > upperBound
        PUT "Invalid guess. Enter a numberbetween the lowerBound and upperBound."
        GET guess
    ENDWHILE
ENDWHILE
PUT "Congratulations! You guessed correctly."

END
        

   

END hilow_game


